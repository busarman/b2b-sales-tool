# A browser password alone is not API access. Leave unset until access is verified.
YANDEX_DISK_PRICES_PATH=
YANDEX_DISK_PRICES_PUBLIC_KEY=
STOCK_VAT_MULTIPLIER=1.22
STOCK_MAX_REMOVAL_SHARE=0.5
STOCK_SYNC_APPLY=false
RESEND_API_KEY=
RESERVATION_EMAIL_TO=anton.soshnev@uind.ru
RESERVATION_EMAIL_FROM=B2B Portal <reserve@your-domain.example>
RESERVATION_RATE_LIMIT_SALT=
## Access expiry is inclusive (YYYY-MM-DD). Renew after owner provides new access.
YANDEX_PRICES_ACCESS_UNTIL=2026-12-30
## Optional; defaults to the existing reservation notification recipient.
SYNC_ALERT_EMAIL_TO=
